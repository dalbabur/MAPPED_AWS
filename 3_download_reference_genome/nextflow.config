nextflow.enable.dsl=2
process.container = 'staphb/ncbi-datasets:18.0.2'

// Define parameters with default values
params.ref_accession = null
params.organism = null
params.outdir = null
params.cpu = null

profiles {
  // Default profile (used automatically when no -profile is given): local Docker.
  standard {
    def hostUid = ['id','-u'].execute().text.trim()
    def hostGid = ['id','-g'].execute().text.trim()
    docker.enabled = true
    docker.runOptions = "-u ${hostUid}:${hostGid}"
  }

  // AWS Batch + S3. See AWS_SETUP.md for the environment this expects.
  awsbatch {
    includeConfig "${projectDir}/../aws.config"
  }
}
