// Enable DSL2
nextflow.enable.dsl2 = true

// Default parameters
params.outdir  = null        // Path to working directory with seqFiles and samplesheet

// Process‐specific containers
process {
    withName: 'FASTQC' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'TRIMGALORE' {
        container = 'quay.io/biocontainers/trim-galore:0.6.9--hdfd78af_0'
    }
    withName: 'SALMON_INDEX' {
        container = 'quay.io/biocontainers/salmon:1.10.3--h45fbf2d_4'
    }
    withName: 'SALMON_QUANT' {
        container = 'quay.io/biocontainers/salmon:1.10.3--h45fbf2d_4'
    }
}

profiles {
  // Default profile (used automatically when no -profile is given): local Docker.
  // `executor = 'local'` here makes explicit what previously happened only by accident:
  // the original config set this via an invalid `defaults {}` scope that Nextflow
  // silently ignores, so the module always ran on the implicit default local executor
  // regardless of that block's presence.
  standard {
    // No local `def` variable declarations here -- Nextflow (26.x+) rejects mixing
    // plain Groovy variable declarations with config statements inside a profile block.
    // Compute inline instead.
    docker.enabled = true
    docker.runOptions = "-u ${['id','-u'].execute().text.trim()}:${['id','-g'].execute().text.trim()}"
    process.executor = 'local'
  }

  // AWS Batch + S3. See AWS_SETUP.md for the environment this expects.
  awsbatch {
    includeConfig "${projectDir}/../aws.config"
  }
}
