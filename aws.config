//
// Shared AWS Batch configuration, included by every module's `awsbatch` profile
// (see profiles{} block in each module's nextflow.config).
//
// This file assumes the AWS environment described in AWS_SETUP.md: an EC2 Spot-backed
// AWS Batch compute environment in us-east-1, with the AWS CLI baked into the compute
// environment's launch template/AMI and bind-mounted into every job container (required
// by Nextflow's classic 'awsbatch' executor to stage files to/from S3).
//

aws {
    region = 'us-east-1'   // co-locates compute with the SRA AWS Open Data buckets (also us-east-1)
                            // and this pipeline's own S3 buckets, avoiding inter-region transfer

    batch {
        // Path to the AWS CLI *inside the job container*. Nextflow automatically bind-
        // mounts cliPath's parent directory from the host into every job container at
        // the same path -- no separate `volumes` entry needed (an earlier explicit
        // `volumes = '/usr/local/aws-cli'` here duplicated that same auto-mount, which
        // AWS Batch's job-definition validation rejects: "containerPath values aren't
        // unique across mountPoints"). Must match the launch template's install path
        // (see AWS_SETUP.md §6).
        cliPath = '/usr/local/aws-cli/bin/aws'

        maxParallelTransfers = 8
        maxTransferAttempts  = 3

        // Optional: IAM role each job container assumes, scoped to just this pipeline's
        // S3 bucket (see AWS_SETUP.md §3.3) instead of inheriting the broader EC2
        // instance role. Set via --aws_batch_job_role_arn, or leave unset (null) to fall
        // back to the compute environment's instance role.
        // Note: a plain expression, not an `if` block -- Nextflow (26.x+) rejects `if`
        // statements mixed with config statements too, the same as `def` declarations.
        jobRole = params.aws_batch_job_role_arn ?: null
    }
}

// Note: no top-level `def` variable declarations in this file below this point. This
// whole file gets spliced directly inside each module's `profiles { awsbatch { ... } }`
// block via includeConfig, and Nextflow (26.x+) rejects mixing plain Groovy variable
// declarations with config statements inside a profile block ("Variable declarations
// cannot be mixed with config statements") -- so the Spot-retry exit code check
// (128+SIGTERM/SIGKILL range, plus AWS Batch's own "host terminated" code 104) is
// inlined at each use below instead of factored into a shared variable.

process {
    executor = 'awsbatch'
    queue    = params.aws_batch_queue ?: 'mapped-spot-queue'

    // No docker.enabled/runOptions here: AWS Batch always runs jobs in containers
    // regardless of Nextflow's own docker.* config (that setting only governs Nextflow's
    // *local* docker executor), and the local-only UID/GID mapping used by the
    // `standard` profile would be meaningless on Batch anyway. (An earlier
    // `docker.enabled = true` nested inside this process{} block was a no-op --
    // Nextflow warns `Unrecognized config option 'process.docker.enabled'` -- since that
    // setting only takes effect at the top-level docker{} scope, not nested in process{}.)

    // Generic fallback for any process not matched by a more specific selector below
    // (e.g. FETCH_METADATA/FORMAT_METADATA in module 1, DOWNLOAD_REFERENCE in module 3,
    // SRA_RUNINFO_TO_FTP in module 2). AWS Batch needs a concrete cpu/memory request to
    // build a job definition; withLabel/withName selectors always take precedence over
    // this regardless of file order, so it only fills gaps. This also supersedes module
    // 2's own blanket `process.cpus = params.cpu` (which defaults to 1) for AWS runs,
    // since this file is included after that assignment.
    cpus   = 2
    memory = 2.GB

    // Activates the two labels already present in the codebase
    // (2_download_fastq/modules/sra_fastq_ftp, sra_ids_to_runinfo) that currently have
    // no matching selector anywhere.
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }
    withLabel: 'error_retry' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // Module 4 processes have no labels today; target by name instead of adding new
    // labels to main.nf. cpus match the thread counts already hardcoded in each script
    // (fastqc/trim_galore/salmon --threads/-p 4) -- raising cpus further would pay for
    // vCPUs the tools don't actually use.
    withName: 'EXTRACT_CDS|SALMON_INDEX|MERGE_COUNTS|MULTIQC|PARSE_QC|FILTER_SAMPLESHEET|FILTER_LOW_EXPRESSION_SAMPLES|NORMALIZE_LOG_TPM' {
        cpus = 2
        memory = { 4.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        maxRetries = 3
    }
    withName: 'FASTQC|TRIMGALORE|SALMON_QUANT' {
        cpus = 4
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        maxRetries = 3
    }
    withName: 'DATA_VALIDATION' {
        cpus = 2
        memory = 4.GB
        // Keep this process strict on genuine failures (it already does today), but
        // still retry Spot-reclaim interruptions rather than terminating the whole run.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
        maxRetries = 2
    }
}
