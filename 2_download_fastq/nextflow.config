// Enable DSL2
nextflow.enable.dsl2 = true

// Define pipeline parameters
params.outdir = ""
params.ena_metadata_fields = ''
params.skip_fastq_download = false
params.publish_dir_mode = 'copy'
params.nf_core_pipeline = ''
params.nf_core_rnaseq_strandedness = 'auto'
params.sample_mapping_fields = ''
// Default to pulling FASTQ directly from NCBI SRA's AWS Open Data buckets (SRA_FASTQ_AWSODP).
// Set to 'ftp' to fall back to the original ENA-FTP download path (SRA_FASTQ_FTP).
params.download_method = 'sratools'
params.max_concurrent_downloads = 20
// Container image for SRA_FASTQ_AWSODP (sra-tools + AWS CLI; built from docker/sra-fastq-awsodp/).
// Set this to the ECR URI you pushed it to (see AWS_SETUP.md §7).
params.sra_awsodp_container = null

// Define default CPU per process and apply it globally
params.cpu = 1
process {
    cpus = params.cpu
}

profiles {
  // Default profile (used automatically when no -profile is given): local Docker.
  standard {
    def hostUid = ['id','-u'].execute().text.trim()
    def hostGid = ['id','-g'].execute().text.trim()
    docker {
      enabled = true
      runOptions = "-u ${hostUid}:${hostGid}"
    }
  }

  // AWS Batch + S3. See AWS_SETUP.md for the environment this expects.
  awsbatch {
    includeConfig "${projectDir}/../aws.config"
  }
}