params {
  library_layout = 'both'
}

process {
  withName: FETCH_METADATA {
    container = 'quay.io/biocontainers/entrez-direct:22.4--he881be0_0'
  }

  withName: FORMAT_METADATA {
    container = 'felixlohmeier/pandas:1.3.3'
  }
}

profiles {
  // Default profile (used automatically when no -profile is given): local Docker.
  standard {
    // No local `def` variable declarations here -- Nextflow (26.x+) rejects mixing
    // plain Groovy variable declarations with config statements inside a profile block.
    // Compute inline instead.
    docker {
      enabled = true
      runOptions = "-u ${['id','-u'].execute().text.trim()}:${['id','-g'].execute().text.trim()}"
    }
    process.executor = 'local'
  }

  // AWS Batch + S3. See AWS_SETUP.md for the environment this expects.
  awsbatch {
    includeConfig "${projectDir}/../aws.config"
  }
}
